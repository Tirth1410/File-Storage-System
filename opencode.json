{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase-prod": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ibxsuqhrvqczastlhvsv&read_only=true",
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "supabase-dev": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ynrtpwjapwtkeshenfvs&read_only=true",
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "graft": {
      "type": "local",
      "command": ["graft", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "vercel_deploy*": "deny",
    "vercel_buy*": "deny",
    "vercel_import-claude-design-from-url": "deny",
    "vercel_get_access_to_vercel_url": "deny",
    "vercel_get_access*": "deny",
    "vercel_change_toolbar*": "deny",
    "vercel_reply_to_toolbar*": "deny",
    "vercel_edit_toolbar*": "deny",
    "vercel_add_toolbar*": "deny",
    "vercel_update_project*": "deny",
    "vercel_use_vercel_cli": "deny",
    "vercel_use*": "deny"
  }
}

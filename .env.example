BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase PostgreSQL Connection Strings
# Pooled Connection (Supavisor / Transaction Mode for serverless application queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (for Prisma migrations / db push)
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Redis & Rate Limiting Configuration
REDIS_URL="rediss://default:your_upstash_token@your_upstash_host:6379"
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Application Environment (dev / prod)
ENVIRONMENT=dev
DEV_URL=http://localhost:3000
PROD_URL=https://your-production-url.vercel.app


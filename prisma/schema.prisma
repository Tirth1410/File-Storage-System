// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?        @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  quotaUsage       QuotaUsage?
  auditLogs        AuditLog[]
  filePermissions  FilePermission[]
  ownedGroups      Group[]          @relation("GroupOwner")
  groupMembers     GroupMember[]
  sharedGroupFiles GroupFile[]      @relation("SharedGroupFiles")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model File {
  id           String           @id @default(uuid()) @db.Uuid
  ownerUserId  String
  groupId      String?          @db.Uuid
  bucket       String
  objectKey    String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  status       String // uploading | available | failed | deleted
  visibility   String // private | group | link
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  sessions     UploadSession[]
  shareLinks   ShareLink[]
  permissions  FilePermission[]
  groupFiles   GroupFile[]

  @@map("file")
}

model UploadSession {
  id              String    @id @default(uuid()) @db.Uuid
  fileId          String    @db.Uuid
  userId          String
  storageUploadId String
  objectKey       String
  sizeBytes       BigInt
  partSizeBytes   BigInt
  status          String // initiated | uploading | completed | aborted | expired | failed
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  completedAt     DateTime?
  file            File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("upload_session")
}

model QuotaUsage {
  userId     String   @id @map("user_id")
  quotaBytes BigInt   @default(209715200) @map("quota_bytes") // 200 MB default
  usedBytes  BigInt   @default(0) @map("used_bytes")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quota_usage")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  action    String // upload_initiated | upload_success | upload_aborted | upload_expired | download_requested | download_success | download_failed | file_deleted
  fileId    String?  @map("file_id") @db.Uuid
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

model ShareLink {
  id            String    @id @default(uuid()) @db.Uuid
  fileId        String    @db.Uuid
  token         String    @unique
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  allowDownload Boolean   @default(true)
  allowPreview  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("share_link")
}

model FilePermission {
  id         String   @id @default(uuid()) @db.Uuid
  fileId     String   @db.Uuid
  userId     String
  permission String // read | write
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@map("file_permission")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerUserId String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User          @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  groupFiles GroupFile[]

  @@map("group")
}

model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @db.Uuid
  userId   String
  role     String // OWNER | ADMIN | MEMBER
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_member")
}

model GroupFile {
  id             String   @id @default(uuid()) @db.Uuid
  groupId        String   @db.Uuid
  fileId         String   @db.Uuid
  sharedByUserId String
  allowPreview   Boolean  @default(true)
  allowDownload  Boolean  @default(true)
  isActive       Boolean  @default(true)
  sharedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group        Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  file         File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sharedByUser User  @relation("SharedGroupFiles", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, fileId])
  @@map("group_file")
}
